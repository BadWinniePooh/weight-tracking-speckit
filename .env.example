# =============================================================================
# weight-tracking — Environment Configuration
# Copy this file to .env and fill in the values marked as REQUIRED.
# Variables marked [optional] have defaults and do not need to be set unless
# you want to override the default behaviour.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Hostname of the PostgreSQL service.
# Use 'db' for Docker Compose internal networking (default for production).
DB_HOST=db

# Port PostgreSQL listens on.
DB_PORT=5432

# Name of the PostgreSQL database.
DB_NAME=weighttracker

# PostgreSQL username.
DB_USER=weighttracker

# PostgreSQL password.
# REQUIRED — change this before deploying to any internet-accessible host.
DB_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# JWT signing secret used to sign authentication tokens.
# REQUIRED — must be at least 32 characters.
# Generate a secure value with: openssl rand -base64 32
JWT_SECRET=change_me_generate_with_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Application URLs & CORS
# -----------------------------------------------------------------------------

# Base URL used by the browser to construct API endpoint URLs.
# Leave empty ("") when using nginx to proxy /api/ internally (production default).
# The browser calls the same public origin; nginx routes /api/ to the backend.
# Set to the full backend URL (e.g. http://localhost:8080) only for direct-access
# local development without the nginx proxy.
API_URL=

# CORS allowed origin — must exactly match the URL users use to access the app.
# REQUIRED — e.g. https://weight.example.com
ALLOWED_ORIGIN=https://your-domain.example.com

# Public URL of the app used in outbound email links (e.g. password-reset URLs).
# REQUIRED — set to the same value as your public domain.
# [optional] Defaults to http://localhost:3000 if not set.
APP_BASE_URL=https://your-domain.example.com

# -----------------------------------------------------------------------------
# Email (SMTP)
# All SMTP settings are optional. If not configured, outbound emails
# (e.g. password-reset) will fail silently. Use real values for production.
# -----------------------------------------------------------------------------

# Hostname of the SMTP server for outbound email.
# [optional] Default: localhost
SMTP_HOST=localhost

# SMTP server port.
# Common values: 587 for STARTTLS, 465 for SSL/TLS, 1025 for local MailHog.
# [optional] Default: 1025
SMTP_PORT=1025

# SMTP authentication username.
# [optional] Leave blank if the SMTP server does not require authentication.
SMTP_USER=

# SMTP authentication password.
# [optional] Leave blank if the SMTP server does not require authentication.
SMTP_PASSWORD=

# From-address for outbound emails.
# [optional] Default: noreply@example.com
SMTP_SENDER_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# Admin Bootstrap (optional)
# Uncomment to auto-seed an admin account on first run (when no users exist).
# If omitted, the interactive setup wizard is used instead.
# Change the password immediately after first login.
# -----------------------------------------------------------------------------

#ADMIN_USERNAME=admin
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=change_me

# -----------------------------------------------------------------------------
# User Lifecycle
# -----------------------------------------------------------------------------

# Number of days a user account remains in pending-deletion state before it is
# permanently removed from the database.
# [optional] Default: 30
USER_DELETION_GRACE_DAYS=30

# -----------------------------------------------------------------------------
# Traefik Integration
# These settings configure how the app is exposed via your existing Traefik
# reverse proxy instance. Traefik must already be running on the host with
# the specified Docker network and certificate resolver configured.
# -----------------------------------------------------------------------------

# Public hostname for Traefik routing and TLS certificate (no scheme, no trailing slash).
# REQUIRED — e.g. weight.example.com
APP_DOMAIN=weight.example.com

# Name of the external Docker network that the Traefik instance uses for service discovery.
# Must match the network name in your Traefik deployment.
# [optional] Default: traefik
TRAEFIK_NETWORK=traefik

# Name of the certificate resolver defined in Traefik's static configuration.
# Must match the resolver name in your Traefik deployment (e.g. letsencrypt, cloudflare).
# [optional] Default: letsencrypt
TRAEFIK_CERT_RESOLVER=letsencrypt

# -----------------------------------------------------------------------------
# Rate Limiting (auth endpoints)
# Controls the rate limit applied to /api/auth/login and
# /api/auth/reset-password/request to prevent brute-force attacks.
# Limits are enforced per source IP by Traefik middleware.
# -----------------------------------------------------------------------------

# Maximum average number of requests allowed per period per source IP.
# [optional] Default: 5
AUTH_RATE_LIMIT_AVERAGE=5

# Duration of the rate limit window (e.g. 1m, 30s, 5m).
# [optional] Default: 1m
AUTH_RATE_LIMIT_PERIOD=1m

# Maximum burst of requests allowed above the average rate before rejecting.
# A burst of 10 absorbs short spikes (e.g. double-click) without blocking.
# [optional] Default: 10
AUTH_RATE_LIMIT_BURST=10
