# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit it.

# The URL from which the frontend will be accessed in a browser.
# Must match the exact origin (scheme + host + port) used by users.
# Examples:
#   http://localhost:3030          (local machine only)
#   http://192.168.1.100:3030      (LAN access by IP)
#   http://myserver.local:3030     (LAN access by hostname)
ALLOWED_ORIGIN=http://localhost:3030
